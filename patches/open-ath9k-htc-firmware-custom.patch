+static a_int32_t  custom_th_avg_rssi = 0;        /* last tick's average RSSI    */
+
+extern a_uint8_t custom_tx_power;   /* defined below in this file */
+
+/* single knob used for every data-frame TX descriptor (if_owl.c) */
+a_uint8_t custom_tx_power_effective(void)
+{
+	a_int32_t p = custom_tx_power;
+
+	if (custom_tx_cap < p)
+		p = custom_tx_cap;
+	if (custom_th_decided_cap < p)
+		p = custom_th_decided_cap;
+	p -= custom_th_backoff;
+	if (p < CUSTOM_TH_POWER_FLOOR)
+		p = CUSTOM_TH_POWER_FLOOR;
+	return (a_uint8_t)p;
+}
+
+/* per-frame hook: stats, RSSI histogram, MAC filter verdict */
+static a_bool_t custom_rx_frame_process(struct ath_softc_tgt *sc,
+					struct ath_rx_status *rxstats,
+					struct ieee80211_frame *wh)
+{
+	a_int32_t rssi;
+
+	if (!custom_rx_hooks)
+		return FALSE;   /* isolation: stock RX path only */
+
+	(void)sc;
+	custom_rx_frames_total++;
+	custom_rx_frames_window++;
+
+	if (rxstats->rs_phyerr) {
+		custom_phy_errs_total++;
+		custom_phy_errs_window++;
+	}
+
+	rssi = rxstats->rs_rssi_combined;
+	if (rssi < 0)
+		rssi = 0;
+	if (rssi > (CUSTOM_RSSI_BINS - 1))
+		rssi = CUSTOM_RSSI_BINS - 1;
+	if (custom_rssi_hist[rssi] != 0xFFFF)
+		custom_rssi_hist[rssi]++;
+	custom_rssi_total++;
+	custom_rssi_win_sum += rssi;   /* v4: thermal governor input */
+
+	/* v3: beacon counter */
+	if ((wh->i_fc[0] & 0x0c) == 0 && (wh->i_fc[0] & 0xf0) == 0x80) {
+		custom_beacons_window++;
+	}
+
+	/* v3: mini-NetFlow accounting */
+	{
+		a_int8_t slot = custom_nfl_find(wh->i_addr1);
+		if (slot < 0)
+			slot = custom_nfl_find(wh->i_addr2);
+		if (slot < 0)
+			slot = custom_nfl_insert(wh->i_addr1);
+		if (slot >= 0) {
+			a_uint32_t blen = rxstats->rs_datalen;
+			a_uint32_t nb = custom_nfl_bytes[slot] + blen;
+
+			if (custom_nfl_frames[slot] != 0xFFFF)
+				custom_nfl_frames[slot]++;
+			custom_nfl_bytes[slot] = (nb > 0xFFFF) ? 0xFFFF : nb;
+		}
+	}
+
+	return custom_rx_filter_frame(wh);
+}
