+	rsp.diag_rsp_allocfail = adf_os_htonl(custom_rsp_allocfail);
+	rsp.diag_pool_memfail  = adf_os_htonl(custom_pool_memfail);
+	rsp.diag_evt_entries   = adf_os_htonl(custom_evt_entries);
