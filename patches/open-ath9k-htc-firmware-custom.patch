+#define CUSTOM_FIND_SIG_FIRSTEP_S   12
+#define CUSTOM_REG_FIND_SIG_LOW     0x9840
+#define CUSTOM_FIND_SIG_LOW_M       0x00000FC0
+#define CUSTOM_FIND_SIG_LOW_S       6
+#define CUSTOM_REG_CCA              0x9864
+#define CUSTOM_MINCCA_M             0x0FF80000
+#define CUSTOM_MINCCA_S             19
