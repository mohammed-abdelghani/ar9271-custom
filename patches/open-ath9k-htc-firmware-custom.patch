+static a_int32_t custom_read_nf(struct ath_softc_tgt *sc)
+{
+	a_uint32_t v = (ioread32_mac(CUSTOM_REG_CCA) & CUSTOM_MINCCA_M) >> CUSTOM_MINCCA_S;
+	a_int32_t nf = (a_int32_t)v;
+
+	(void)sc;
+	if (nf & 0x100)
+		nf -= 0x200;
+	return nf;
+}
+
+static void custom_ani_write_level(struct ath_softc_tgt *sc, a_uint32_t level)
+{
+	a_uint32_t value = level * 2;
+	a_uint32_t v;
+
+	(void)sc;
+	v = ioread32_mac(CUSTOM_REG_FIND_SIG);
+	v = (v & ~CUSTOM_FIND_SIG_FIRSTEP_M) | (value << CUSTOM_FIND_SIG_FIRSTEP_S);
+	iowrite32_mac(CUSTOM_REG_FIND_SIG, v);
+
+	v = ioread32_mac(CUSTOM_REG_FIND_SIG_LOW);
+	v = (v & ~CUSTOM_FIND_SIG_LOW_M) | (value << CUSTOM_FIND_SIG_LOW_S);
+	iowrite32_mac(CUSTOM_REG_FIND_SIG_LOW, v);
+}
