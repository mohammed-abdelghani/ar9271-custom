+/* CUSTOM BUILD: runtime rate-control profile.
+ * custom_rc_step_dn_inc is consumed by ath_tgt_rate_findrate() (if_owl.c):
+ * 1 = clean-air profile (slower fallback), 2 = noisy-air profile (faster).
+ * custom_rc_fixed_rate: 0xFF = auto rate control, else fixed rate table index. */
+a_uint32_t custom_rc_step_dn_inc = 2;
+a_uint8_t  custom_rc_fixed_rate = 0xFF;
+
+static void handle_rc_profile_cmd(void *Context, A_UINT16 Command,
+				  A_UINT16 SeqNo, A_UINT8 *buffer,
+				  a_int32_t Length)
+{
+	struct ath_softc_tgt *sc = (struct ath_softc_tgt *)Context;
+	WMI_CUSTOM_RC_PROFILE_RSP rsp;
+
+	if (buffer && Length >= (a_int32_t)sizeof(WMI_CUSTOM_RC_PROFILE_CMD)) {
+		a_uint32_t val = adf_os_ntohl(((WMI_CUSTOM_RC_PROFILE_CMD *)buffer)->step_dn_inc);
+		a_uint32_t fr  = adf_os_ntohl(((WMI_CUSTOM_RC_PROFILE_CMD *)buffer)->fixed_rate_idx);
+		a_uint32_t nt  = adf_os_ntohl(((WMI_CUSTOM_RC_PROFILE_CMD *)buffer)->num_tries);
+		a_uint32_t nr  = adf_os_ntohl(((WMI_CUSTOM_RC_PROFILE_CMD *)buffer)->num_rates);
+
+		if (val != 0)
+			custom_rc_step_dn_inc = val;
+		if (fr <= 0x7F || fr == 0xFF)
+			custom_rc_fixed_rate = (a_uint8_t)fr;
+		if (nt >= 1 && nt <= 32)
+			custom_rc_num_tries = nt;
+		if (nr >= 1 && nr <= 4)
+			custom_rc_num_rates = nr;
+	}
+
+	rsp.step_dn_inc = adf_os_htonl(custom_rc_step_dn_inc);
+	rsp.fixed_rate_idx = adf_os_htonl(custom_rc_fixed_rate);
+	rsp.num_tries = adf_os_htonl(custom_rc_num_tries);
+	rsp.num_rates = adf_os_htonl(custom_rc_num_rates);
+	wmi_cmd_rsp(sc->tgt_wmi_handle, Command, SeqNo,
+		    (A_UINT8 *)&rsp, sizeof(rsp));
+}
