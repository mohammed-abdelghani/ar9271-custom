+	rsp.echo_payload = adf_os_htonl(payload);
+	rsp.pong_counter = adf_os_htonl(++custom_ping_counter);
+
+	/* CUSTOM BUILD v3-diag: live control-path counters piggyback on the
+	 * ping reply - the host can watch the target breathe without any
+	 * dedicated telemetry channel. */
