+/* CUSTOM BUILD v4: thermal governor control. mode/cap = CUSTOM_TH_QUERY
+ * (0xFF) leaves the field untouched; flags can flip the RX-hook isolation
+ * switch at runtime (bisect tool, docs/10). Reply is 28B - well under the
+ * 64B reply budget. */
+static void handle_thermal_cmd(void *Context, A_UINT16 Command,
+			       A_UINT16 SeqNo, A_UINT8 *buffer,
+			       a_int32_t Length)
+{
+	struct ath_softc_tgt *sc = (struct ath_softc_tgt *)Context;
+	WMI_CUSTOM_THERMAL_RSP rsp;
+
+	if (buffer && Length >= (a_int32_t)sizeof(WMI_CUSTOM_THERMAL_CMD)) {
+		WMI_CUSTOM_THERMAL_CMD *cmd = (WMI_CUSTOM_THERMAL_CMD *)buffer;
+		a_uint32_t mode = adf_os_ntohl(cmd->mode);
+		a_uint32_t cap = adf_os_ntohl(cmd->cap);
+		a_uint32_t flags = adf_os_ntohl(cmd->flags);
+
+		if (mode != CUSTOM_TH_QUERY)
+			custom_th_mode = (a_uint8_t)(mode & 0x3);
+		/* v4-fix: cap 0xFF = uncapped (docs/12) - the old gate treated
+		 * 0xFF as the query marker for BOTH fields, making "cap 255"
+		 * (uncap) unreachable; the cap query marker is now 0x100. */
+		if (cap != CUSTOM_TH_CAP_QUERY)
+			custom_tx_cap = (a_uint8_t)((cap <= 0x3F) ? cap : 0xFF);
+		if (flags & CUSTOM_TH_FLAG_HOOKS_ON)
+			custom_rx_hooks = 1;
+		else if (flags & CUSTOM_TH_FLAG_HOOKS_OFF)
+			custom_rx_hooks = 0;
+	}
+
+	rsp.mode = adf_os_htonl(custom_th_mode);
+	rsp.cap = adf_os_htonl(custom_tx_cap);
+	rsp.backoff = adf_os_htonl(custom_th_backoff);
+	rsp.effective = adf_os_htonl(custom_tx_power_effective());
+	rsp.avg_rssi = adf_os_htonl((a_uint32_t)custom_th_avg_rssi);
+	rsp.tx_window = adf_os_htonl(custom_th_tx_window);
+	rsp.rx_window = adf_os_htonl(custom_th_rx_window);
+
+	wmi_cmd_rsp(sc->tgt_wmi_handle, Command, SeqNo,
+		    (A_UINT8 *)&rsp, sizeof(rsp));
+}
