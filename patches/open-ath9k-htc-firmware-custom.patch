+static a_bool_t custom_mac_in_table(a_uint8_t *addr)
+{
+	a_uint8_t i, j;
+
+	for (i = 0; i < custom_mf_count; i++) {
+		for (j = 0; j < 6; j++)
+			if (custom_mf_mac[i][j] != addr[j])
+				break;
+		if (j == 6)
+			return TRUE;   /* matched (all-zero entries never match) */
+	}
+	return FALSE;
+}
+
+/* returns TRUE when this frame must NOT be uploaded to the host */
+static a_bool_t custom_rx_filter_frame(struct ieee80211_frame *wh)
+{
+	a_bool_t hit;
+
+	if (custom_mf_mode == 0 || custom_mf_count == 0)
+		return FALSE;
+
+	hit = custom_mac_in_table(wh->i_addr1) || custom_mac_in_table(wh->i_addr2);
+
+	if (custom_mf_mode == 1)
+		return !hit;    /* allow-list: drop everything not in the table */
+	return hit;         /* block-list: drop matching frames */
+}
