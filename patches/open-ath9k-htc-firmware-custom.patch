+/* periodic chores, rate-limited by CUSTOM_TICK_MS; driven by the RX path
+ * (beacons of the associated AP keep this alive when idle) and SWBA (AP). */
+static void custom_periodic_chores(struct ath_softc_tgt *sc, a_bool_t from_swba)
+{
+	struct ath_hal *ah = sc->sc_ah;
+	WMI_CUSTOM_TELEMETRY_EVT evt;
+	a_uint32_t now = A_MS_TICKGET();
+
+	if (now - custom_tick_last_ms < CUSTOM_TICK_MS)
+		return;
+	custom_tick_last_ms = now;
+	custom_uptime_ticks++;
+
+	/* 1) firmware-side adaptive ANI (v3: firstep + CCA threshold offset) */
+	if (custom_ani_auto && custom_rx_frames_window > 50) {
+		a_uint32_t rate = custom_phy_errs_window * 1000 / custom_rx_frames_window;
+		a_uint8_t stepped = 0;
+
+		if (rate > 200 && custom_ani_level < 2) {
+			custom_ani_level++;
+			custom_ani_write_level(sc, custom_ani_level);
+			stepped = 1;
+		} else if (rate < 20 && custom_ani_level > 0) {
+			custom_ani_level--;
+			custom_ani_write_level(sc, custom_ani_level);
+			stepped = 1;
+		}
+
+		if (stepped) {
+			a_uint32_t reg = ioread32_mac(0x9864);
+			a_uint8_t byte;
+
+			custom_log_bb(1, custom_ani_level);
+			if (rate > 200 && custom_cca_offset < 12) {
+				custom_cca_offset += 3;
+				byte = (a_uint8_t)(custom_cca_base + custom_cca_offset);
+				reg = (reg & ~0x000000FF) | byte;
+				iowrite32_mac(0x9864, reg);
+			} else if (rate < 20 && custom_cca_offset > 0) {
+				custom_cca_offset -= 3;
+				byte = (a_uint8_t)(custom_cca_base + custom_cca_offset);
+				reg = (reg & ~0x000000FF) | byte;
+				iowrite32_mac(0x9864, reg);
+			}
+		}
+	}
+
+	/* 1b) v3: auto-spectral burst on PHY-error spikes */
+	if (custom_spec_auto && !custom_spec_active &&
+	    custom_rx_frames_window > 50) {
+		a_uint32_t rate = custom_phy_errs_window * 1000 / custom_rx_frames_window;
+		a_uint32_t reg = ioread32_mac(0x9910);
+
+		if (rate > custom_spec_threshold) {
+			iowrite32_mac(0x9910, reg | 0x00000003);   /* ENA|ACTIVE */
+			custom_spec_active = 1;
+			custom_spec_ticks = 3;
+			custom_log_bb(4, rate);
+		}
+	} else if (custom_spec_active) {
+		a_uint32_t reg = ioread32_mac(0x9910);
+
+		if (--custom_spec_ticks == 0) {
+			iowrite32_mac(0x9910, reg & ~0x00000003);
+			custom_spec_active = 0;
+		}
+	}
+
+	/* 2) watchdog: wedged beacon queue (AP mode) -> self-reset request */
+	if (from_swba) {
+		a_uint32_t pending = ah->ah_numTxPending(ah, sc->sc_bhalq);
+
+		if (pending > 0 && pending >= custom_wd_last_pending) {
+			if (++custom_wd_strikes >= 3) {
+				/* CUSTOM BUILD v3-fix: this used to fire
+				 * WMI_FATAL_EVENTID (self-reset request) from the
+				 * SWBA context. In station mode sc_bhalq is not a
+				 * configured queue and ah_numTxPending can read
+				 * stale garbage, striking a host reset while the
+				 * host is mid-command - the control path then
+				 * wedges permanently. Strikes are still counted
+				 * and recorded in the black box for post-mortem,
+				 * but the reset request is gone. */
+				custom_log_bb(2, custom_wd_strikes);
+				custom_wd_strikes = 0;
+			}
+		} else {
+			custom_wd_strikes = 0;
+		}
+		custom_wd_last_pending = pending;
+	}
+
+	/* 2b) CUSTOM BUILD v4: thermal governor (PA heat = output power x duty) */
+	{
+		a_uint32_t txd = 0, i;
+
+		for (i = 0; i < CUSTOM_RATE_USAGE_MAX; i++)
+			txd += custom_rate_usage[i];
+		if (txd > custom_th_tx_last)
+			txd -= custom_th_tx_last;
+		else
+			txd = 0;   /* counters wrapped or were reset */
+		custom_th_tx_last += txd;
+		custom_th_tx_window = txd;
+		custom_th_rx_window = custom_rx_frames_window;
+
+		if (custom_rx_frames_window) {
+			custom_th_avg_rssi = (a_int32_t)
+			    (custom_rssi_win_sum / custom_rx_frames_window);
+			custom_rssi_win_sum = 0;
+		}
+
+		if (custom_th_mode & CUSTOM_TH_MODE_RSSI_CAP) {
+			a_uint8_t cap;
+
+			if (custom_th_avg_rssi >= CUSTOM_TH_RSSI_HI)
+				cap = CUSTOM_TH_CAP_STRONG;
+			else if (custom_th_avg_rssi < CUSTOM_TH_RSSI_LO)
+				cap = CUSTOM_TH_CAP_WEAK;
+			else
+				cap = custom_th_decided_cap;  /* hysteresis band */
+
+			if (custom_tx_cap < cap)
+				cap = custom_tx_cap;  /* static cap always wins */
+			if (cap != custom_th_decided_cap) {
+				custom_th_decided_cap = cap;
+				custom_log_bb(5, ((a_uint32_t)custom_th_backoff << 8) | cap);
+			}
+		} else if (custom_th_decided_cap != 0xFF) {
+			custom_th_decided_cap = 0xFF;
+			custom_log_bb(5, 0xFF);
+		}
+
+		if (custom_th_mode & CUSTOM_TH_MODE_DUTY_BKOF) {
+			if (txd > CUSTOM_TH_TX_BUSY &&
+			    custom_th_backoff < CUSTOM_TH_BACKOFF_MAX)
+				custom_th_backoff += 2;
+			else if (txd < CUSTOM_TH_TX_IDLE && custom_th_backoff > 0)
+				custom_th_backoff--;
+		} else if (custom_th_backoff) {
+			custom_th_backoff = 0;
+		}
+	}
+
+	/* 3) TELEMETRY EVENT WITHDRAWN (recovery fix): the periodic event drained
+	 * the HTC control-endpoint credits while associated (~1400 events froze
+	 * the ctl path: command replies died with it). The window counters are
+	 * still maintained; telemetry returns later via a credit-safe design. */
+	(void)evt;
+	custom_rx_frames_window = 0;
+	custom_phy_errs_window = 0;
+}
