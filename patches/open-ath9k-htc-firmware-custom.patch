+/* CUSTOM BUILD v2: RSSI histogram query/reset */
+static void handle_rssi_hist_cmd(void *Context, A_UINT16 Command,
+				 A_UINT16 SeqNo, A_UINT8 *buffer,
+				 a_int32_t Length)
+{
+	struct ath_softc_tgt *sc = (struct ath_softc_tgt *)Context;
+	WMI_CUSTOM_RSSI_HIST_RSP rsp;
+	a_uint32_t i;
+	a_uint8_t do_reset = 0;
+
+	(void)Command;
+	if (buffer && Length >= (a_int32_t)sizeof(WMI_CUSTOM_RSSI_HIST_CMD))
+		do_reset = (adf_os_ntohl(((WMI_CUSTOM_RSSI_HIST_CMD *)buffer)->reset) == 1);
+
+	for (i = 0; i < WMI_CUSTOM_RSSI_HIST_BINS; i++)
+		rsp.bins[i] = custom_rssi_hist[i];
+
+	if (do_reset) {
+		adf_os_mem_set(custom_rssi_hist, 0, sizeof(custom_rssi_hist));
+		custom_rssi_total = 0;
+	}
+
+	wmi_cmd_rsp(sc->tgt_wmi_handle, Command, SeqNo,
+		    (A_UINT8 *)&rsp, sizeof(rsp));
+}
+
+/* CUSTOM BUILD v2: radio-level MAC filter configuration */
+static void handle_macfilter_cmd(void *Context, A_UINT16 Command,
+				 A_UINT16 SeqNo, A_UINT8 *buffer,
+				 a_int32_t Length)
+{
+	struct ath_softc_tgt *sc = (struct ath_softc_tgt *)Context;
+	WMI_CUSTOM_MACFILTER_RSP rsp;
+	WMI_CUSTOM_MACFILTER_CMD *cmd = (WMI_CUSTOM_MACFILTER_CMD *)buffer;
+	a_uint32_t i;
+
+	(void)Command;
+	if (buffer && Length >= (a_int32_t)sizeof(WMI_CUSTOM_MACFILTER_CMD)) {
+		a_uint32_t action = adf_os_ntohl(cmd->action);
+		a_uint32_t mode = adf_os_ntohl(cmd->mode);
+		a_uint32_t index = adf_os_ntohl(cmd->index);
+
+		switch (action) {
+		case CUSTOM_MF_ACTION_SETMODE:
+			if (mode <= 2)
+				custom_mf_mode = (a_uint8_t)mode;
+			break;
+		case CUSTOM_MF_ACTION_ADD:
+			if (index < CUSTOM_MACFILTER_MAX) {
+				for (i = 0; i < 6; i++)
+					custom_mf_mac[index][i] = cmd->mac[i];
+				if ((a_uint8_t)(index + 1) > custom_mf_count)
+					custom_mf_count = (a_uint8_t)(index + 1);
+			}
+			break;
+		case CUSTOM_MF_ACTION_DEL:
+			if (index < CUSTOM_MACFILTER_MAX)
+				adf_os_mem_set(custom_mf_mac[index], 0, 6);
+			break;
+		case CUSTOM_MF_ACTION_CLEAR:
+			adf_os_mem_set(custom_mf_mac, 0, sizeof(custom_mf_mac));
+			custom_mf_count = 0;
+			break;
+		case CUSTOM_MF_ACTION_QUERY:
+		default:
+			break;
+		}
+	}
+
+	rsp.mode = adf_os_htonl(custom_mf_mode);
+	rsp.count = adf_os_htonl(custom_mf_count);
+	rsp.dropped = adf_os_htonl(custom_mf_dropped);
+	wmi_cmd_rsp(sc->tgt_wmi_handle, Command, SeqNo,
+		    (A_UINT8 *)&rsp, sizeof(rsp));
+}
+
+/* CUSTOM BUILD v3: Block-ACK window runtime tuning (pow2, 1..64).
+ * Applies to TIDs initialised from now on; live nodes keep their window. */
+static void handle_baw_cmd(void *Context, A_UINT16 Command,
+			   A_UINT16 SeqNo, A_UINT8 *buffer,
+			   a_int32_t Length)
+{
+	struct ath_softc_tgt *sc = (struct ath_softc_tgt *)Context;
+	WMI_CUSTOM_BAW_RSP rsp;
+	a_uint32_t eff = custom_baw_size ? custom_baw_size : WME_MAX_BA;
+
+	(void)Command;
+	if (buffer && Length >= (a_int32_t)sizeof(WMI_CUSTOM_BAW_CMD)) {
+		a_uint32_t v = adf_os_ntohl(((WMI_CUSTOM_BAW_CMD *)buffer)->baw_size);
+
+		if (v >= 1 && v <= WME_BA_BMP_SIZE) {
+			while (v & (v - 1))
+				v++;
+			custom_baw_size = v;
+			eff = v;
+			custom_log_bb(7, eff);
+		}
+	}
+
+	rsp.effective = adf_os_htonl(eff);
+	wmi_cmd_rsp(sc->tgt_wmi_handle, Command, SeqNo,
+		    (A_UINT8 *)&rsp, sizeof(rsp));
+}
+
+/* CUSTOM BUILD v3: long-distance mode - MAC ACK timeout in microseconds. */
+static void handle_longdist_cmd(void *Context, A_UINT16 Command,
+				A_UINT16 SeqNo, A_UINT8 *buffer,
+				a_int32_t Length)
+{
+	struct ath_softc_tgt *sc = (struct ath_softc_tgt *)Context;
+	WMI_CUSTOM_LONGDIST_RSP rsp;
+	a_uint32_t reg = ioread32_mac(0x8014);   /* AR_TIME_OUT */
+	a_uint32_t cur = reg & 0x00003FFF;
+
+	(void)Command;
+	if (buffer && Length >= (a_int32_t)sizeof(WMI_CUSTOM_LONGDIST_CMD)) {
+		a_uint32_t v = adf_os_ntohl(((WMI_CUSTOM_LONGDIST_CMD *)buffer)->ack_timeout_us);
+
+		if (v >= 1 && v <= 0x3FFF) {
+			reg = (reg & ~0x00003FFF) | v;
+			iowrite32_mac(0x8014, reg);
+			cur = v;
+			custom_log_bb(8, v);
+		}
+	}
+
+	rsp.ack_timeout_us = adf_os_htonl(cur);
+	wmi_cmd_rsp(sc->tgt_wmi_handle, Command, SeqNo,
+		    (A_UINT8 *)&rsp, sizeof(rsp));
+}
+
+/* CUSTOM BUILD v3: the host reports the current channel; pair with NF. */
+static void handle_freq_note_cmd(void *Context, A_UINT16 Command,
+				 A_UINT16 SeqNo, A_UINT8 *buffer,
+				 a_int32_t Length)
+{
+	struct ath_softc_tgt *sc = (struct ath_softc_tgt *)Context;
+	WMI_CUSTOM_FREQ_NOTE_RSP rsp;
+	a_uint32_t freq = 0;
+	a_uint8_t i, slot;
+
+	(void)Command;
+	if (buffer && Length >= (a_int32_t)sizeof(WMI_CUSTOM_FREQ_NOTE_CMD))
+		freq = adf_os_ntohl(((WMI_CUSTOM_FREQ_NOTE_CMD *)buffer)->freq_mhz);
+
+	if (freq) {
+		slot = 0xFF;
+		for (i = 0; i < custom_fs_count; i++)
+			if (custom_fs_freq[i] == freq)
+				slot = i;
+		if (slot == 0xFF && custom_fs_count < 12)
+			slot = custom_fs_count++;
+		if (slot == 0xFF)
+			slot = (a_uint8_t)(custom_fs_rr++ % 12);
+		if (slot != 0xFF) {
+			custom_fs_freq[slot] = (a_uint16_t)freq;
+			custom_fs_nf[slot] = (a_int16_t)custom_read_nf(sc);
+			custom_log_bb(3, freq);
+		}
+	}
+
+	rsp.entries = adf_os_htonl(custom_fs_count);
+	wmi_cmd_rsp(sc->tgt_wmi_handle, Command, SeqNo,
+		    (A_UINT8 *)&rsp, sizeof(rsp));
+}
