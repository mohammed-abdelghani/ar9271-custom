+static void handle_custom_ping_cmd(void *Context, A_UINT16 Command,
+				   A_UINT16 SeqNo, A_UINT8 *buffer,
+				   a_int32_t Length)
+{
+	struct ath_softc_tgt *sc = (struct ath_softc_tgt *)Context;
+	WMI_CUSTOM_PING_RSP rsp;
+	a_uint32_t payload = 0;
