+static a_int8_t custom_nfl_find(a_uint8_t *addr)
+{
+	a_uint8_t i, j;
+
+	for (i = 0; i < custom_nfl_count; i++) {
+		for (j = 0; j < 6; j++)
+			if (custom_nfl_mac[i][j] != addr[j])
+				break;
+		if (j == 6)
+			return (a_int8_t)i;
+	}
+	return -1;
+}
+
+static a_int8_t custom_nfl_insert(a_uint8_t *addr)
+{
+	a_int8_t slot;
+	a_uint8_t j;
+
+	if (custom_nfl_count < 4) {
+		slot = (a_int8_t)custom_nfl_count++;
+	} else {
+		slot = (a_int8_t)custom_nfl_next;
+		custom_nfl_next = (custom_nfl_next + 1) % 4;
+	}
+	for (j = 0; j < 6; j++)
+		custom_nfl_mac[slot][j] = addr[j];
+	custom_nfl_frames[slot] = 0;
+	custom_nfl_bytes[slot] = 0;
+	return slot;
+}
