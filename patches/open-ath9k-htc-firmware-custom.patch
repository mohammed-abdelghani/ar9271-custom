+/* CUSTOM BUILD v3: mini-NetFlow query/reset */
+static void handle_netflow_cmd(void *Context, A_UINT16 Command,
+			       A_UINT16 SeqNo, A_UINT8 *buffer,
+			       a_int32_t Length)
+{
+	struct ath_softc_tgt *sc = (struct ath_softc_tgt *)Context;
+	WMI_CUSTOM_NETFLOW_RSP rsp;
+	a_uint8_t do_reset = 0;
+	a_uint8_t i;
+
+	(void)Command;
+	if (buffer && Length >= (a_int32_t)sizeof(WMI_CUSTOM_NETFLOW_CMD))
+		do_reset = (adf_os_ntohl(((WMI_CUSTOM_NETFLOW_CMD *)buffer)->reset) == 1);
+
+	adf_os_mem_set(&rsp, 0, sizeof(rsp));
+	rsp.count = custom_nfl_count;
+	for (i = 0; i < custom_nfl_count; i++) {
+		a_uint16_t bytes = custom_nfl_bytes[i];
+
+		adf_os_mem_copy(rsp.ent[i].mac, custom_nfl_mac[i], 6);
+		rsp.ent[i].frames = adf_os_htons(custom_nfl_frames[i]);
+		/* v4-fix: single u16 in 256B units (saturating) keeps the reply
+		 * at 44B payload / 56B on the wire (the old 12B entry made the
+		 * reply exactly 64B and jammed the USB controller). */
+		rsp.ent[i].bytes_256 = adf_os_htons(bytes >> 8);
+	}
+
+	if (do_reset) {
+		adf_os_mem_set(custom_nfl_frames, 0, sizeof(custom_nfl_frames));
+		adf_os_mem_set(custom_nfl_bytes, 0, sizeof(custom_nfl_bytes));
+	}
+
+	wmi_cmd_rsp(sc->tgt_wmi_handle, Command, SeqNo,
+		    (A_UINT8 *)&rsp, sizeof(rsp));
+}
+
+/* CUSTOM BUILD v3: per-channel NF survey query */
+static void handle_chan_survey_cmd(void *Context, A_UINT16 Command,
+				   A_UINT16 SeqNo, A_UINT8 *buffer,
+				   a_int32_t Length)
+{
+	struct ath_softc_tgt *sc = (struct ath_softc_tgt *)Context;
+	WMI_CUSTOM_CHAN_SURVEY_RSP rsp;
+	a_uint8_t i;
+
+	(void)Command;
+	(void)buffer;
+	(void)Length;
+
+	adf_os_mem_set(&rsp, 0, sizeof(rsp));
+	rsp.count = custom_fs_count;
+	for (i = 0; i < custom_fs_count; i++) {
+		a_int32_t nf = custom_fs_nf[i];
+
+		/* v4-fix: reply nf is s8 now - clamp before narrowing */
+		if (nf > 0)
+			nf = 0;
+		if (nf < -128)
+			nf = -128;
+		rsp.ent[i].freq_mhz = adf_os_htons(custom_fs_freq[i]);
+		rsp.ent[i].nf_dbm = (a_int8_t)nf;
+	}
+
+	wmi_cmd_rsp(sc->tgt_wmi_handle, Command, SeqNo,
+		    (A_UINT8 *)&rsp, sizeof(rsp));
+}
+
+/* CUSTOM BUILD v3: firmware auto-spectral control */
+static void handle_auto_spec_cmd(void *Context, A_UINT16 Command,
+				 A_UINT16 SeqNo, A_UINT8 *buffer,
+				 a_int32_t Length)
+{
+	struct ath_softc_tgt *sc = (struct ath_softc_tgt *)Context;
+	WMI_CUSTOM_AUTO_SPEC_RSP rsp;
+
+	(void)Command;
+	if (buffer && Length >= (a_int32_t)sizeof(WMI_CUSTOM_AUTO_SPEC_CMD)) {
+		a_uint32_t en = adf_os_ntohl(((WMI_CUSTOM_AUTO_SPEC_CMD *)buffer)->enable);
+		a_uint32_t th = adf_os_ntohl(((WMI_CUSTOM_AUTO_SPEC_CMD *)buffer)->threshold);
+
+		if (en == 0 || en == 1) {
+			if (en == 0 && custom_spec_active) {
+				a_uint32_t reg = ioread32_mac(0x9910);
+				iowrite32_mac(0x9910, reg & ~0x00000003);
+				custom_spec_active = 0;
+			}
+			custom_spec_auto = (a_uint8_t)en;
+			custom_log_bb(6, en);
+		}
+		if (th >= 10 && th <= 900)
+			custom_spec_threshold = th;
+	}
+
+	rsp.enable = adf_os_htonl(custom_spec_auto);
+	rsp.threshold = adf_os_htonl(custom_spec_threshold);
+	rsp.active = adf_os_htonl(custom_spec_active);
+	wmi_cmd_rsp(sc->tgt_wmi_handle, Command, SeqNo,
+		    (A_UINT8 *)&rsp, sizeof(rsp));
+}
+
+/* CUSTOM BUILD v3: black-box ring buffer paging */
+static void handle_blackbox_cmd(void *Context, A_UINT16 Command,
+				A_UINT16 SeqNo, A_UINT8 *buffer,
+				a_int32_t Length)
+{
+	struct ath_softc_tgt *sc = (struct ath_softc_tgt *)Context;
+	WMI_CUSTOM_BLACKBOX_RSP rsp;
+	a_uint32_t page = 0;
+	a_uint8_t j;
+
+	(void)Command;
+	if (buffer && Length >= (a_int32_t)sizeof(WMI_CUSTOM_BLACKBOX_CMD))
+		page = adf_os_ntohl(((WMI_CUSTOM_BLACKBOX_CMD *)buffer)->page);
+	if (page >= 4)
+		page = 0;
+
+	adf_os_mem_set(&rsp, 0, sizeof(rsp));
+	rsp.head = custom_bb_head;
+	rsp.count = custom_bb_count;
+	for (j = 0; j < 4; j++) {
+		a_uint8_t idx = (a_uint8_t)((custom_bb_head + 16 - 1 -
+					     (page * 4 + j)) % 16);
+		rsp.ent[j] = adf_os_htonl(custom_bb[idx]);
+	}
+
+	wmi_cmd_rsp(sc->tgt_wmi_handle, Command, SeqNo,
+		    (A_UINT8 *)&rsp, sizeof(rsp));
+}
