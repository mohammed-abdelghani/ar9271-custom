+/* CUSTOM BUILD v2: per-rate TX usage histogram (counted in rcRateSetseries) */
+static void handle_rate_usage_cmd(void *Context, A_UINT16 Command,
+				  A_UINT16 SeqNo, A_UINT8 *buffer,
+				  a_int32_t Length)
+{
